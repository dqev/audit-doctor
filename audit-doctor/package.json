{
  "name": "audit-doctor",
  "version": "0.0.2",
  "description": "Comprehensive audit & AI agent fixer generator for 39+ web application production-readiness standards",
  "keywords": [
    "audit",
    "doctor",
    "seo",
    "accessibility",
    "security",
    "ux",
    "performance",
    "nextjs",
    "react",
    "agent",
    "ai-fixing"
  ],
  "license": "MIT",
  "author": "dqev",
  "bin": {
    "audit-doctor": "./dist/cli.mjs",
    "audit-doc": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rm -rf dist && tsdown && cp README.md dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^11.0.1",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.20.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
